// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  content   String?
  symbol    String   @default("PHRS")
  author    String
  createdAt DateTime @default(now())
  tx_hash   String?  @unique
  image_url String?

  comments Comment[]
  likes    Like[]
  bookmarks Bookmark[]
}

model User {
  id               String   @id @default(cuid())
  pharos_address   String   @unique
  sovereign_layout Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Like {
  id             String   @id @default(cuid())
  pharos_address String
  post_id_onchain String
  createdAt      DateTime @default(now())
  
  post           Post     @relation(fields: [post_id_onchain], references: [id])

  @@unique([pharos_address, post_id_onchain])
}

model Bookmark {
  id              String   @id @default(cuid())
  pharos_address  String
  post_id_onchain String
  createdAt       DateTime @default(now())

  post            Post     @relation(fields: [post_id_onchain], references: [id])

  @@unique([pharos_address, post_id_onchain])
}

model Comment {
  id              String   @id @default(cuid())
  content         String
  pharos_address  String
  post_id_onchain String
  createdAt       DateTime @default(now())
  
  parent_id       String?
  parent          Comment?  @relation("replies", fields: [parent_id], references: [id])
  replies         Comment[] @relation("replies")
  post            Post      @relation(fields: [post_id_onchain], references: [id])
}

model Message {
  id               String   @id @default(cuid())
  sender_address   String
  receiver_address String
  content          String // Encrypted
  createdAt        DateTime @default(now())
}
